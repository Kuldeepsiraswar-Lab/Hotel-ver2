rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Restaurant Profiles
    match /restaurant_profiles/{profileId} {
      allow read, write: if true;
    }

    // Menu Items & Catalog
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    // Orders & Table Invoices
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Expenses & Vendor Ledger
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Staff Accounts & PIN Authentication
    match /staff_accounts/{staffId} {
      allow read, write: if true;
    }

    // Live Staff Notifications & Table QR Call Alerts
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Menu Categories
    match /menu_categories/{catId} {
      allow read, write: if true;
    }

    // Menu Tags & Culinary Badges
    match /menu_tags/{tagId} {
      allow read, write: if true;
    }
  }
}
